{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/**/*.tsx",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "standalone/**/*.tsx",
    "vite.standalone.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".deps",
    "releases",
    "server/web"
  ]
}
